<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup for Android 9–11 (API 28–30). Android 12+ uses
    data_extraction_rules.xml instead. Keep both files in sync.
    Cache (camera temp, label sheets) is never backed up.
-->
<full-backup-content>
    <!-- Room database incl. -wal / -shm -->
    <include domain="database" path="." />
    <!-- Product photos (ProductImageStorage.IMAGES_DIR) -->
    <include domain="file" path="images/" />
    <!-- Preferences, if the app ever stores any -->
    <include domain="sharedpref" path="." />
</full-backup-content>